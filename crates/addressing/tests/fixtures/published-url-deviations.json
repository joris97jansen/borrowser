{
  "file-windows-drive-pipe": {
    "href": {"expected": "file:///w:/m", "actual": "file:///w|/m"},
    "pathname": {"expected": "/w:/m", "actual": "/w|/m"}
  },
  "opaque-path-trailing-space": {
    "href": {"expected": "non-special:opaque %20?hi", "actual": "non-special:opaque  ?hi"},
    "pathname": {"expected": "opaque %20", "actual": "opaque  "}
  },
  "file-repeated-path-slashes": {
    "href": {"expected": "file://spider///", "actual": "file://spider/"},
    "pathname": {"expected": "///", "actual": "/"}
  },
  "file-localhost-repeated-slashes": {
    "href": {"expected": "file://///", "actual": "file:///"},
    "pathname": {"expected": "///", "actual": "/"}
  },
  "file-domain-and-drive": {
    "host": {"expected": "example.net", "actual": ""},
    "hostname": {"expected": "example.net", "actual": ""},
    "href": {"expected": "file://example.net/C:/", "actual": "file:///C:/"}
  },
  "file-ipv4-and-drive": {
    "host": {"expected": "1.2.3.4", "actual": ""},
    "hostname": {"expected": "1.2.3.4", "actual": ""},
    "href": {"expected": "file://1.2.3.4/C:/", "actual": "file:///C:/"}
  },
  "file-ipv6-and-drive": {
    "host": {"expected": "[1::8]", "actual": ""},
    "hostname": {"expected": "[1::8]", "actual": ""},
    "href": {"expected": "file://[1::8]/C:/", "actual": "file:///C:/"}
  },
  "file-empty-host-repeated-slash": {
    "href": {"expected": "file:////foo", "actual": "file:///foo"},
    "pathname": {"expected": "//foo", "actual": "/foo"}
  },
  "idna-ascii-xn-label": {
